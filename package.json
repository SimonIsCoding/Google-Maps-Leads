{
  "name": "mapscraperhub",
  "version": "1.0.0",
  "description": "MapScraperHub - Transform Google Maps searches into Google Sheets",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
	"build:vercel": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "test": "jest",
    "test:watch": "jest --watch",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.9.1",
    "@auth/prisma-adapter": "^1.4.0",
    "next": "14.1.0",
    "next-auth": "^4.24.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "stripe": "^14.14.0",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "@sendgrid/mail": "^8.1.0",
    "zod": "^3.22.4",
    "uuid": "^9.0.1",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^9.0.7",
    "@types/jest": "^29.5.11",
    "typescript": "^5.3.3",
    "prisma": "^5.9.1",
    "tsx": "^4.7.0",
    "tailwindcss": "^3.4.1",
    "postcss": "^8.4.33",
    "autoprefixer": "^10.4.17",
    "jest": "^29.7.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/jest-dom": "^6.2.0",
    "ts-jest": "^29.1.1",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
