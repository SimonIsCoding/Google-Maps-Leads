# This is a local development example
# Copy this to .env for local development

# Database (using docker-compose PostgreSQL)
DATABASE_URL="postgresql://mapscraperhub:mapscraperhub_dev@localhost:5432/mapscraperhub?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="development-secret-change-in-production"

# Google OAuth (optional - leave empty to disable)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (use test mode keys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_ID_100_CREDITS="price_..."
STRIPE_PRICE_ID_500_CREDITS="price_..."
STRIPE_PRICE_ID_1000_CREDITS="price_..."

# External Scraper Webhook (mock endpoint for development)
SCRAPER_WEBHOOK_URL="http://localhost:3000/api/mock-scraper"

# Application Base URL
APP_BASE_URL="http://localhost:3000"

# SendGrid (optional - leave empty to skip sending emails)
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL="noreply@mapscraperhub.local"

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS="10"
RATE_LIMIT_WINDOW_MS="60000"

# Admin
ADMIN_EMAIL="admin@mapscraperhub.com"

# Logging
LOG_LEVEL="debug"
